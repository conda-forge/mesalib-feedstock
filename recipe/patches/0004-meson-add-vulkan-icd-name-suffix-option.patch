Add a vulkan-icd-name-suffix meson option so the Vulkan ICD libraries can be
installed under a distinct name (libvulkan_intel.conda.so) that does not collide
with a system ICD whose manifest uses a bare "library_path".  Meson sets the
SONAME of an unversioned shared_library to its file name, so the SONAME changes
too, which glibc needs to keep a bare-name dlopen() from matching our driver.
Related: https://github.com/KhronosGroup/Vulkan-Loader/issues/2017

diff --git a/meson.build b/meson.build
index 59d30c8..b76e2e9 100644
--- a/meson.build
+++ b/meson.build
@@ -31,6 +31,12 @@ else
   libname_suffix = 'so'
 endif
 
+if get_option('vulkan-icd-name-suffix') != ''
+  vulkan_icd_libname_suffix = get_option('vulkan-icd-name-suffix') + '.' + libname_suffix
+else
+  vulkan_icd_libname_suffix = libname_suffix
+endif
+
 cc = meson.get_compiler('c')
 cpp = meson.get_compiler('cpp')
 fs = import('fs')
diff --git a/meson.options b/meson.options
index beb2837..de35693 100644
--- a/meson.options
+++ b/meson.options
@@ -280,6 +280,15 @@ option(
                 'Default: $datadir/vulkan/icd.d'
 )
 
+option(
+  'vulkan-icd-name-suffix',
+  type : 'string',
+  value : '',
+  description : 'Extra suffix for Vulkan ICD library file names, e.g. "foo" ' +
+                'installs libvulkan_intel.foo.so and points the ICD manifest ' +
+                'at it, so it does not collide with a system ICD of the same name.'
+)
+
 option(
   'vulkan-manifest-per-architecture',
   type : 'boolean',
